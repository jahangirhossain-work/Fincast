{
  "builds": [
    { "src": "api/forecast.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/forecast", "destination": "/api/forecast.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
